<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane id="AnchorPane" nodeOrientation="RIGHT_TO_LEFT" prefHeight="880.0" prefWidth="1280.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Interfaces.reports">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         
         <!-- ================= TOP HEADER BAR ================= -->
         <top>
            <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="6.0" left="22.0" right="22.0" top="14.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER" maxHeight="74.0" minHeight="68.0" prefHeight="70.0" styleClass="header-bar">
                     <children>
                        
                        <!-- USER BADGE SECTION -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane style="-fx-background-color: #FFF3EB; -fx-background-radius: 50%; -fx-min-width: 42px; -fx-min-height: 42px; -fx-border-color: #FF7043; -fx-border-radius: 50%; -fx-border-width: 1.5px;">
                                 <children>
                                    <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#E65100" scaleX="1.1" scaleY="1.1" />
                                 </children>
                              </StackPane>
                              <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                 <children>
                                    <HBox alignment="CENTER_RIGHT" spacing="6.0">
                                       <children>
                                          <Circle fill="#4CAF50" radius="4.0" />
                                          <Label fx:id="lblUserName" styleClass="info-chip-text" text="كريم الدين" textFill="#2B1810" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lblUserRole" styleClass="info-chip-label" text="المدير العام • Admin" textFill="#FF6B00" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- BRAND / TITLE CENTER SECTION -->
                        <HBox alignment="CENTER" spacing="12.0">
                           <children>
                              <StackPane style="-fx-background-color: linear-gradient(to bottom right, #FF7043, #E65100); -fx-background-radius: 12px; -fx-min-width: 44px; -fx-min-height: 44px;">
                                 <children>
                                    <!-- Analytics / BarChart Icon -->
                                    <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" fill="WHITE" scaleX="1.1" scaleY="1.1" />
                                 </children>
                              </StackPane>
                              <VBox alignment="CENTER_RIGHT">
                                 <children>
                                    <Label styleClass="header-brand-title" text="التقارير والإحصائيات" />
                                    <Label styleClass="header-brand-subtitle" text="تحليلات المبيعات، الإيرادات، وسلوك العملاء" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- DATE & LIVE TIME CHIPS -->
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <!-- DATE CHIP -->
                              <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="info-chip">
                                 <children>
                                    <SVGPath content="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z" fill="#E65100" scaleX="0.85" scaleY="0.85" />
                                    <VBox alignment="CENTER_RIGHT">
                                       <children>
                                          <Label fx:id="lblDate" styleClass="info-chip-text" text="السبت، 22 أغسطس 2026" />
                                          <Label styleClass="info-chip-label" text="تاريخ اليوم" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                              <!-- LIVE CLOCK CHIP -->
                              <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="info-chip">
                                 <children>
                                    <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="#E65100" scaleX="0.9" scaleY="0.9" />
                                    <VBox alignment="CENTER_RIGHT">
                                       <children>
                                          <Label fx:id="lblTime" styleClass="live-time-text" text="00:00:00 م" />
                                          <Label styleClass="info-chip-label" text="الوقت المباشر" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        
                     </children>
                  </HBox>
               </children>
            </VBox>
         </top>

         <!-- ================= CENTER CONTENT (SCROLLABLE) ================= -->
         <center>
            <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="main-scroll-pane" BorderPane.alignment="CENTER">
               <content>
                  <VBox spacing="16.0">
                     <padding>
                        <Insets bottom="12.0" left="22.0" right="22.0" top="6.0" />
                     </padding>
                     <children>
                        
                        <!-- ================= 1. KPI SUMMARY TILES ROW ================= -->
                        <GridPane hgap="16.0" vgap="12.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="90.0" />
                           </rowConstraints>
                           <children>
                              
                              <!-- KPI 1: TOTAL REVENUE -->
                              <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kpi-card" GridPane.columnIndex="0">
                                 <children>
                                    <StackPane style="-fx-background-color: linear-gradient(to bottom right, #FFF3EB, #FFE2CC); -fx-background-radius: 14px; -fx-min-width: 48px; -fx-min-height: 48px; -fx-border-color: #FF8F4D; -fx-border-radius: 14px; -fx-border-width: 1.5px;">
                                       <children>
                                          <!-- Money Bag SVG -->
                                          <SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" fill="#E65100" scaleX="1.1" scaleY="1.1" />
                                       </children>
                                    </StackPane>
                                    <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                       <children>
                                          <Label fx:id="lblTotalRevenue" styleClass="kpi-value" text="١٤٨,٥٠٠ ج.م" />
                                          <Label styleClass="kpi-label" text="إجمالي الإيرادات" />
                                          <Label styleClass="kpi-subtext" text="▲ +١٤٪ مقارنة بالفترة السابقة" textFill="#2E7D32" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                              <!-- KPI 2: TOTAL ORDERS -->
                              <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kpi-card" GridPane.columnIndex="1">
                                 <children>
                                    <StackPane style="-fx-background-color: linear-gradient(to bottom right, #FFF3EB, #FFE2CC); -fx-background-radius: 14px; -fx-min-width: 48px; -fx-min-height: 48px; -fx-border-color: #FF8F4D; -fx-border-radius: 14px; -fx-border-width: 1.5px;">
                                       <children>
                                          <!-- Receipt / POS Icon -->
                                          <SVGPath content="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z" fill="#E65100" scaleX="1.1" scaleY="1.1" />
                                       </children>
                                    </StackPane>
                                    <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                       <children>
                                          <Label fx:id="lblTotalOrders" styleClass="kpi-value" text="١,٢٤٠ طلب" />
                                          <Label styleClass="kpi-label" text="إجمالي الطلبات المباعة" />
                                          <Label styleClass="kpi-subtext" text="متوسط ٤٥ طلب / يوم" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                              <!-- KPI 3: TOP SELLING PRODUCT -->
                              <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kpi-card" GridPane.columnIndex="2">
                                 <children>
                                    <StackPane style="-fx-background-color: linear-gradient(to bottom right, #FFF3EB, #FFE2CC); -fx-background-radius: 14px; -fx-min-width: 48px; -fx-min-height: 48px; -fx-border-color: #FF8F4D; -fx-border-radius: 14px; -fx-border-width: 1.5px;">
                                       <children>
                                          <!-- Trophy / Star Icon -->
                                          <SVGPath content="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" fill="#E65100" scaleX="1.1" scaleY="1.1" />
                                       </children>
                                    </StackPane>
                                    <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                       <children>
                                          <Label fx:id="lblTopProduct" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #E65100;" text="برجر ميكس لحم دوبل" />
                                          <Label styleClass="kpi-label" text="المنتج الأكثر مبيعًا" />
                                          <Label fx:id="lblTopProductSales" styleClass="kpi-subtext" text="٣٨٠ قطعة مباعة" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                              <!-- KPI 4: TOP CUSTOMER -->
                              <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="kpi-card" GridPane.columnIndex="3">
                                 <children>
                                    <StackPane style="-fx-background-color: linear-gradient(to bottom right, #FFF3EB, #FFE2CC); -fx-background-radius: 14px; -fx-min-width: 48px; -fx-min-height: 48px; -fx-border-color: #FF8F4D; -fx-border-radius: 14px; -fx-border-width: 1.5px;">
                                       <children>
                                          <!-- Crown / VIP Customer Icon -->
                                          <SVGPath content="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .55-.45 1-1 1H6c-.55 0-1-.45-1-1v-1h14v1z" fill="#E65100" scaleX="1.1" scaleY="1.1" />
                                       </children>
                                    </StackPane>
                                    <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                       <children>
                                          <Label fx:id="lblTopCustomer" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #E65100;" text="محمد طارق الأحمدي" />
                                          <Label styleClass="kpi-label" text="العميل الأكثر شراءً (VIP)" />
                                          <Label fx:id="lblTopCustomerSpent" styleClass="kpi-subtext" text="إجمالي: ٨,٦٥٠ ج.م" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                           </children>
                        </GridPane>

                        <!-- ================= 2. TWO INTERACTIVE CHARTS ROW ================= -->
                        <GridPane hgap="16.0" vgap="12.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                              <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="330.0" />
                           </rowConstraints>
                           <children>
                              
                              <!-- CHART 1: REVENUE PER DAY (BAR CHART) -->
                              <VBox spacing="8.0" styleClass="panel-card" GridPane.columnIndex="0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <SVGPath content="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z" fill="#E65100" scaleX="1.1" scaleY="1.1" />
                                          <Label styleClass="panel-header-title" text="إحصائية الإيراد اليومي (Revenue Per Day)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label styleClass="panel-header-desc" text="خلال أيام الأسبوع الحالي" />
                                       </children>
                                    </HBox>
                                    <BarChart fx:id="chartDailyRevenue" animated="false" legendVisible="false" minHeight="270.0" prefHeight="280.0" styleClass="custom-chart" VBox.vgrow="ALWAYS">
                                      <xAxis>
                                        <CategoryAxis fx:id="axisDailyDays" label="اليوم" side="BOTTOM" />
                                      </xAxis>
                                      <yAxis>
                                        <NumberAxis fx:id="axisDailyRevenue" label="الإيراد (ج.م)" side="LEFT" />
                                      </yAxis>
                                    </BarChart>
                                 </children>
                              </VBox>

                              <!-- CHART 2: REVENUE PER MONTH (LINE CHART) -->
                              <VBox spacing="8.0" styleClass="panel-card" GridPane.columnIndex="1">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <SVGPath content="M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z" fill="#E65100" scaleX="1.1" scaleY="1.1" />
                                          <Label styleClass="panel-header-title" text="إحصائية الإيراد الشهري (Revenue Per Month)" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label styleClass="panel-header-desc" text="أداء الأشهر خلال العام" />
                                       </children>
                                    </HBox>
                                    <LineChart fx:id="chartMonthlyRevenue" animated="false" legendVisible="false" minHeight="270.0" prefHeight="280.0" styleClass="custom-chart" VBox.vgrow="ALWAYS">
                                      <xAxis>
                                        <CategoryAxis fx:id="axisMonthlyMonths" label="الشهر" side="BOTTOM" />
                                      </xAxis>
                                      <yAxis>
                                        <NumberAxis fx:id="axisMonthlyRevenue" label="الإيراد (ج.م)" side="LEFT" />
                                      </yAxis>
                                    </LineChart>
                                 </children>
                              </VBox>

                           </children>
                        </GridPane>

                        <!-- ================= 3. DETAILED REPORT LISTS & TABLES ================= -->
                        <VBox spacing="10.0" styleClass="panel-card">
                           <children>
                              
                              <!-- SECTION HEADER & CONTROLS -->
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <SVGPath content="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z" fill="#E65100" scaleX="1.1" scaleY="1.1" />
                                    <Label styleClass="panel-header-title" text="جداول التحليلات والتقارير المفصلة" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    
                                    <!-- Period Filter -->
                                    <HBox alignment="CENTER" spacing="6.0">
                                       <children>
                                          <Label styleClass="field-label" text="الفترة الزمنية:" />
                                          <JFXComboBox fx:id="cbPeriod" onAction="#handlePeriodChange" prefWidth="150.0" promptText="اختر الفترة..." styleClass="jfx-combo-box" />
                                       </children>
                                    </HBox>

                                    <!-- Refresh & Export Buttons -->
                                    <JFXButton fx:id="btnRefresh" buttonType="RAISED" onAction="#handleRefreshReports" ripplerFill="#FFE0B2" styleClass="btn-action-clear" text="🔄 تحديث الإحصائيات" />
                                    <JFXButton fx:id="btnExport" buttonType="RAISED" onAction="#handleExportReport" ripplerFill="#FFE0B2" styleClass="btn-action-add" text="🖨️ طباعة التقرير" />
                                 </children>
                              </HBox>

                              <!-- MODERN TABPANE WITH 3 LISTS -->
                              <TabPane prefHeight="380.0" styleClass="custom-tab-pane" tabClosingPolicy="UNAVAILABLE">
                                <tabs>
                                  
                                  <!-- TAB 1: MOST SOLD PRODUCTS (DESCENDING) -->
                                  <Tab text="🔥 المنتجات الأكثر مبيعًا (تنازليًا)">
                                    <content>
                                      <VBox spacing="8.0">
                                         <padding>
                                            <Insets top="10.0" />
                                         </padding>
                                         <children>
                                            <TableView fx:id="tblMostSold" minHeight="300.0" prefHeight="330.0" styleClass="custom-table-view" VBox.vgrow="ALWAYS">
                                              <columns>
                                                <TableColumn fx:id="colSoldRank" maxWidth="70.0" minWidth="50.0" prefWidth="60.0" text="الترتيب" />
                                                <TableColumn fx:id="colSoldName" minWidth="200.0" prefWidth="250.0" text="اسم المنتج / الوجبة" />
                                                <TableColumn fx:id="colSoldCategory" minWidth="130.0" prefWidth="160.0" text="القسم / التصنيف" />
                                                <TableColumn fx:id="colSoldQty" minWidth="130.0" prefWidth="150.0" text="الكمية المباعة (قطعة)" />
                                                <TableColumn fx:id="colSoldShare" minWidth="140.0" prefWidth="160.0" text="نسبة المبيعات" />
                                                <TableColumn fx:id="colSoldTotalRevenue" minWidth="150.0" prefWidth="180.0" text="إجمالي المبيعات (ج.م)" />
                                              </columns>
                                              <columnResizePolicy>
                                                 <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                              </columnResizePolicy>
                                            </TableView>
                                         </children>
                                      </VBox>
                                    </content>
                                  </Tab>

                                  <!-- TAB 2: PRODUCTS OF HIGHEST REVENUE -->
                                  <Tab text="💰 المنتجات الأعلى إيرادًا">
                                    <content>
                                      <VBox spacing="8.0">
                                         <padding>
                                            <Insets top="10.0" />
                                         </padding>
                                         <children>
                                            <TableView fx:id="tblHighestRevenue" minHeight="300.0" prefHeight="330.0" styleClass="custom-table-view" VBox.vgrow="ALWAYS">
                                              <columns>
                                                <TableColumn fx:id="colRevRank" maxWidth="70.0" minWidth="50.0" prefWidth="60.0" text="الترتيب" />
                                                <TableColumn fx:id="colRevName" minWidth="200.0" prefWidth="250.0" text="اسم المنتج / الصنف" />
                                                <TableColumn fx:id="colRevCategory" minWidth="130.0" prefWidth="160.0" text="القسم" />
                                                <TableColumn fx:id="colRevPrice" minWidth="120.0" prefWidth="140.0" text="سعر الوحدة (ج.م)" />
                                                <TableColumn fx:id="colRevQty" minWidth="120.0" prefWidth="140.0" text="الكمية المباعة" />
                                                <TableColumn fx:id="colRevTotal" minWidth="160.0" prefWidth="200.0" text="إجمالي الإيرادات (ج.م)" />
                                              </columns>
                                              <columnResizePolicy>
                                                 <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                              </columnResizePolicy>
                                            </TableView>
                                         </children>
                                      </VBox>
                                    </content>
                                  </Tab>

                                  <!-- TAB 3: MOST PURCHASING CUSTOMERS -->
                                  <Tab text="👑 العملاء الأكثر شراءً">
                                    <content>
                                      <VBox spacing="8.0">
                                         <padding>
                                            <Insets top="10.0" />
                                         </padding>
                                         <children>
                                            <TableView fx:id="tblTopCustomers" minHeight="300.0" prefHeight="330.0" styleClass="custom-table-view" VBox.vgrow="ALWAYS">
                                              <columns>
                                                <TableColumn fx:id="colCustRank" maxWidth="70.0" minWidth="50.0" prefWidth="60.0" text="الترتيب" />
                                                <TableColumn fx:id="colCustName" minWidth="180.0" prefWidth="240.0" text="اسم العميل (Customer Name)" />
                                                <TableColumn fx:id="colCustSpent" minWidth="160.0" prefWidth="200.0" text="إجمالي المبالغ المنفقة (Money Spent)" />
                                                <TableColumn fx:id="colCustOrders" minWidth="120.0" prefWidth="140.0" text="عدد الطلبات" />
                                                <TableColumn fx:id="colCustPhone" minWidth="130.0" prefWidth="160.0" text="رقم الهاتف" />
                                                <TableColumn fx:id="colCustLastOrder" minWidth="130.0" prefWidth="150.0" text="تاريخ آخر طلب" />
                                              </columns>
                                              <columnResizePolicy>
                                                 <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                              </columnResizePolicy>
                                            </TableView>
                                         </children>
                                      </VBox>
                                    </content>
                                  </Tab>

                                </tabs>
                              </TabPane>

                           </children>
                        </VBox>

                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </center>

         <!-- ================= BOTTOM FOOTER BAR ================= -->
         <bottom>
            <HBox alignment="CENTER" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="10.0" left="22.0" right="22.0" top="4.0" />
               </padding>
               <children>
