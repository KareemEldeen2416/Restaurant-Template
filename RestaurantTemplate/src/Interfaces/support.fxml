<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane id="AnchorPane" nodeOrientation="RIGHT_TO_LEFT" prefHeight="820.0" prefWidth="1200.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Interfaces.support">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         
         <!-- ================= TOP HEADER BAR ================= -->
         <top>
            <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="6.0" left="22.0" right="22.0" top="14.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER" maxHeight="74.0" minHeight="68.0" prefHeight="70.0" styleClass="header-bar">
                     <children>
                        
                        <!-- USER BADGE SECTION -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane style="-fx-background-color: #FFF3EB; -fx-background-radius: 50%; -fx-min-width: 42px; -fx-min-height: 42px; -fx-border-color: #FF7043; -fx-border-radius: 50%; -fx-border-width: 1.5px;">
                                 <children>
                                    <SVGPath content="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" fill="#E65100" scaleX="1.1" scaleY="1.1" />
                                 </children>
                              </StackPane>
                              <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                 <children>
                                    <HBox alignment="CENTER_RIGHT" spacing="6.0">
                                       <children>
                                          <Circle fill="#4CAF50" radius="4.0" />
                                          <Label fx:id="lblUserName" styleClass="info-chip-text" text="كريم الدين" textFill="#2B1810" />
                                       </children>
                                    </HBox>
                                    <Label fx:id="lblUserRole" styleClass="info-chip-label" text="الدعم والمساعدة • Support" textFill="#FF6B00" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- BRAND / TITLE CENTER SECTION -->
                        <HBox alignment="CENTER" spacing="12.0">
                           <children>
                              <StackPane style="-fx-background-color: linear-gradient(to bottom right, #FF7043, #E65100); -fx-background-radius: 12px; -fx-min-width: 44px; -fx-min-height: 44px;">
                                 <children>
                                    <!-- Support Headset SVG -->
                                    <SVGPath content="M20 15.5c-.67 0-1.3-.1-1.9-.28l-.27-.08a1.98 1.98 0 0 0-2.02.46l-1.6 1.6a15.045 15.045 0 0 1-6.59-6.59l1.6-1.6c.43-.43.6-.1.46-2.02l-.08-.27A10.74 10.74 0 0 1 9.5 4c0-.55-.45-1-1-1H5c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1z" fill="WHITE" scaleX="1.1" scaleY="1.1" />
                                 </children>
                              </StackPane>
                              <VBox alignment="CENTER_RIGHT">
                                 <children>
                                    <Label styleClass="header-brand-title" text="الدعم الفني والتواصل" />
                                    <Label styleClass="header-brand-subtitle" text="خدمة العملاء، الروابط الرسمية، وبيانات المطور" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- DATE & LIVE TIME CHIPS -->
                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                           <children>
                              <!-- DATE CHIP -->
                              <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="info-chip">
                                 <children>
                                    <SVGPath content="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z" fill="#E65100" scaleX="0.85" scaleY="0.85" />
                                    <VBox alignment="CENTER_RIGHT">
                                       <children>
                                          <Label fx:id="lblDate" styleClass="info-chip-text" text="السبت، 22 أغسطس 2026" />
                                          <Label styleClass="info-chip-label" text="تاريخ اليوم" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>

                              <!-- LIVE CLOCK CHIP -->
                              <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="info-chip">
                                 <children>
                                    <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="#E65100" scaleX="0.9" scaleY="0.9" />
                                    <VBox alignment="CENTER_RIGHT">
                                       <children>
                                          <Label fx:id="lblTime" styleClass="live-time-text" text="00:00:00 م" />
                                          <Label styleClass="info-chip-label" text="الوقت المباشر" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        
                     </children>
                  </HBox>
               </children>
            </VBox>
         </top>

         <!-- ================= CENTER CONTENT (SCROLLABLE) ================= -->
         <center>
            <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="main-scroll-pane" BorderPane.alignment="CENTER">
               <content>
                  <VBox alignment="TOP_CENTER" spacing="18.0">
                     <padding>
                        <Insets bottom="20.0" left="30.0" right="30.0" top="10.0" />
                     </padding>
                     <children>
                        
                        <!-- ================= HERO CARD: COMPANY LOGO IMAGE & TITLE ================= -->
                        <VBox alignment="CENTER" maxWidth="960.0" spacing="12.0" styleClass="support-card">
                           <children>
                              
                              <!-- COMPANY LOGO AS AN IMAGE -->
                              <StackPane style="-fx-background-color: #FFFFFF; -fx-background-radius: 24px; -fx-effect: dropshadow(gaussian, rgba(255, 107, 0, 0.25), 20, 0.2, 0, 6); -fx-padding: 8px;">
                                 <children>
                                    <ImageView fx:id="imgCompanyLogo" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
                                       <image>
                                          <Image url="@../resources/logo.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </StackPane>

                              <VBox alignment="CENTER" spacing="4.0">
                                 <children>
                                    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2B1810;" text="مؤسسة كريم الدين للبرمجيات والحلول الذكية" />
                                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #FF6B00;" text="KareemEldeen Software Solutions • Restaurant ERP System" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #7A6357;" text="نظام إدارة المطاعم الشامل | نقاط البيع، المخزون، الحسابات، وإدارة الصالة والموظفين" />
                                 </children>
                              </VBox>

                           </children>
                        </VBox>

                        <!-- ================= CONTACT INFO & OFFICIAL WEBSITE ================= -->
                        <FlowPane alignment="CENTER" hgap="16.0" maxWidth="960.0" vgap="16.0">
                           <children>
                              
                              <!-- 1. PHONE NUMBER (WITH PHONE ICON) -->
                              <VBox maxWidth="460.0" minWidth="420.0" prefWidth="445.0" spacing="10.0" styleClass="support-contact-chip">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <StackPane style="-fx-background-color: linear-gradient(to bottom right, #FF7043, #E65100); -fx-background-radius: 12px; -fx-min-width: 44px; -fx-min-height: 44px;">
                                             <children>
                                                <!-- Phone Icon SVG -->
                                                <SVGPath content="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" fill="WHITE" scaleX="1.1" scaleY="1.1" />
                                             </children>
                                          </StackPane>
                                          <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                             <children>
                                                <Label styleClass="card-title" text="رقم الهاتف المباشر (Phone Number)" />
                                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #E65100;" text="+20 101 234 5678 / +20 122 345 6789" />
                                                <Label styleClass="info-chip-label" text="متاح يوميًا من الساعة 09:00 ص حتى 11:00 م" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <JFXButton fx:id="btnCallPhone" maxWidth="1.7976931348623157E308" onAction="#handleCallPhone" styleClass="btn-action-add" text="📞 اتصال هاتفي بالدعم الفني" />
                                 </children>
                              </VBox>

                              <!-- 2. WHATSAPP NUMBER (WITH WHATSAPP ICON) -->
                              <VBox maxWidth="460.0" minWidth="420.0" prefWidth="445.0" spacing="10.0" styleClass="support-contact-chip">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                       <children>
                                          <StackPane style="-fx-background-color: #25D366; -fx-background-radius: 12px; -fx-min-width: 44px; -fx-min-height: 44px;">
                                             <children>
                                                <!-- WhatsApp SVG -->
                                                <SVGPath content="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z" fill="WHITE" scaleX="1.1" scaleY="1.1" />
                                             </children>
                                          </StackPane>
                                          <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                             <children>
                                                <Label styleClass="card-title" text="واتساب الدعم الفني (WhatsApp Support)" />
                                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" text="+20 101 234 5678" />
                                                <Label styleClass="info-chip-label" text="رد فوري واستجابة سريعة على مدار 24 ساعة" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <JFXButton fx:id="btnOpenWhatsApp" maxWidth="1.7976931348623157E308" onAction="#handleOpenWhatsApp" style="-fx-background-color: linear-gradient(to right, #25D366, #128C7E); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12px; -fx-padding: 9px;" text="💬 تواصل مباشر عبر واتساب" />
                                 </children>
                              </VBox>

                              <!-- 3. OFFICIAL WEBSITE LINK (WITH WEBSITE ICON) -->
                              <VBox maxWidth="910.0" minWidth="860.0" prefWidth="905.0" spacing="12.0" styleClass="support-card">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="14.0">
                                       <children>
                                          <StackPane style="-fx-background-color: linear-gradient(to bottom right, #FF7043, #E65100); -fx-background-radius: 14px; -fx-min-width: 50px; -fx-min-height: 50px;">
                                             <children>
                                                <!-- Globe / Website SVG -->
                                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="WHITE" scaleX="1.2" scaleY="1.2" />
                                             </children>
                                          </StackPane>
                                          <VBox alignment="CENTER_RIGHT" spacing="3.0">
                                             <children>
                                                <Label styleClass="card-title" text="الموقع الإلكتروني الرسمي (Official Website)" />
                                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #E65100;" text="www.kareeemeldeen.com" />
                                                <Label styleClass="info-chip-label" text="تصفح التحديثات، التوثيق البرمجي، وطلب الميزات الجديدة" />
                                             </children>
                                          </VBox>
                                          <Region HBox.hgrow="ALWAYS" />
                                          <JFXButton fx:id="btnOpenWebsite" buttonType="RAISED" onAction="#handleOpenWebsite" ripplerFill="#FFE0B2" styleClass="btn-website" text="🌐 زيارة الموقع الرسمي" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- 4. SOCIAL MEDIA CHANNELS -->
                              <VBox maxWidth="910.0" minWidth="860.0" prefWidth="905.0" spacing="12.0" styleClass="support-card">
                                 <children>
                                    <Label styleClass="panel-header-title" text="تابعنا على شبكات التواصل الاجتماعي (Social Media Links)" />
                                    <HBox alignment="CENTER" spacing="16.0">
                                       <children>
                                          <!-- Facebook -->
                                          <JFXButton fx:id="btnFacebook" buttonType="RAISED" maxWidth="1.7976931348623157E308" onAction="#handleOpenFacebook" styleClass="btn-social-fb" text="📘 فيسبوك • Facebook" HBox.hgrow="ALWAYS" />
                                          
                                          <!-- Instagram -->
                                          <JFXButton fx:id="btnInstagram" buttonType="RAISED" maxWidth="1.7976931348623157E308" onAction="#handleOpenInstagram" styleClass="btn-social-insta" text="📷 انستغرام • Instagram" HBox.hgrow="ALWAYS" />
                                          
                                          <!-- LinkedIn -->
                                          <JFXButton fx:id="btnLinkedIn" buttonType="RAISED" maxWidth="1.7976931348623157E308" onAction="#handleOpenLinkedIn" styleClass="btn-social-linkedin" text="💼 لينكد إن • LinkedIn" HBox.hgrow="ALWAYS" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                           </children>
                        </FlowPane>

                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </center>

         <!-- ================= BOTTOM FOOTER BAR ================= -->
         <bottom>
            <HBox alignment="CENTER" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="10.0" left="22.0" right="22.0" top="4.0" />
               </padding>
               <children>
                  <HBox alignment="CENTER" spacing="16.0" styleClass="footer-bar">
                     <children>
                        <HBox alignment="CENTER" spacing="6.0">
                           <children>
                              <Circle fill="#4CAF50" radius="4.0" />
                              <Label styleClass="footer-text" text="مركز الدعم والمساعدة نشط" />
                           </children>
                        </HBox>
                        <Label styleClass="footer-text" text="|" />
                        <Label styleClass="footer-highlight" text="www.kareeemeldeen.com" />
                        <Label styleClass="footer-text" text="|" />
                        <Label styleClass="footer-text" text="جميع الحقوق محفوظة © 2026" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </bottom>

      </BorderPane>
   </children>
</AnchorPane>
